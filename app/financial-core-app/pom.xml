<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.fcp</groupId>
        <artifactId>financial-core-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>financial-core-app</artifactId>
    <name>fcp :: app :: bootstrap</name>
    <dependencies>
        <dependency><groupId>com.fcp</groupId><artifactId>service-transaction</artifactId></dependency>
        <dependency><groupId>com.fcp</groupId><artifactId>service-account</artifactId></dependency>
        <dependency><groupId>com.fcp</groupId><artifactId>service-ledger</artifactId></dependency>
        <dependency><groupId>com.fcp</groupId><artifactId>common-api</artifactId></dependency>
        <dependency><groupId>com.fcp</groupId><artifactId>common-domain</artifactId></dependency>
        <dependency><groupId>com.fcp</groupId><artifactId>common-exception</artifactId></dependency>
        <dependency><groupId>com.fcp</groupId><artifactId>common-utils</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
        <!-- Flyway 10 起各数据库支持拆分为独立模块；MySQL 8.4 需 flyway-mysql -->
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-mysql</artifactId></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
        <dependency><groupId>com.mysql</groupId><artifactId>mysql-connector-j</artifactId><scope>runtime</scope></dependency>
        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
        </plugins>
    </build>
</project>
